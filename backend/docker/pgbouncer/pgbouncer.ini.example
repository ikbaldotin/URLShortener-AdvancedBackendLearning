[databases]
url-shorener=host=yourservierip port=yourport dbname=url-shorener user=your user password=your password
[pgbouncer]
listen_addr=0.0.0.0
listen_port=5432

auth_type=plain
auth_file=/etc/pgbouncer/userlist.txt
pool_mode=transaction

max_client_conn=1000
default_pool_size=10
reserve_pool_size=2
server_idle_timeout=60
server_lifetime=3600
log_connection=1
log_diconnections=1 

admin_user=postgress